[global]
repo1-type=s3
repo1-s3-bucket=postgres-agy-backup
repo1-s3-endpoint=319271fed8bc6d2d9059362be1165f37.eu.r2.cloudflarestorage.com
repo1-s3-region=auto
repo1-s3-uri-style=path
repo1-s3-key={{ lookup('env', 'COLORS_PAR_BACKUP_R2_ACCESS_KEY_ID') }}
repo1-s3-key-secret={{ lookup('env', 'COLORS_PAR_BACKUP_R2_SECRET_ACCESS_KEY') }}
repo1-path=/postgres-agy-fixture

repo1-retention-full=4
repo1-retention-full-type=count

compress-type=zst
compress-level=3
process-max=2
start-fast=y
log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest

[main]
pg1-path=/var/lib/postgresql/17/main
pg1-port=5432
pg1-socket-path=/var/run/postgresql
